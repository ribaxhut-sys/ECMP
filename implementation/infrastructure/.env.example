# Local-only Keycloak bootstrap (SEC-MIG Phase 1).
# Used when starting Compose profile `auth`. Never use these values in shared envs.
#
# Copy to `.env` in this directory if you want to override defaults, e.g.:
#   cp .env.example .env

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_local_only

# Host-mapped Keycloak HTTP (compose maps container 8080 → host 8180)
# Issuer (DEV): http://localhost:8180/realms/ecmp

# API base URL. Leave empty (or "/") in local dev to use the Vite proxy
# (vite.config.ts → /v1 → http://localhost:8000). Set an absolute URL only
# when the SPA and API share an origin or CORS is configured.
VITE_API_BASE_URL=

# Dev-mode bearer token (ADR-013 item 7 — token acquisition unresolved).
# Must match one of the backend static fixtures in app/auth.py / .env.example:
#   dev-token                  → cs.agent.1   (cases:create, cases:read)
#   dev-readonly-token         → viewer.1     (cases:read)
#   dev-supervisor-token       → supervisor.1 (cases:assign, cases:read, cases:create; UNIT-01)
#   dev-handler-token          → USR-2001     (cases:status, cases:read)
#   dev-noperm-token           → noperm.1     (no permissions)
#   dev-foreign-supervisor-token → supervisor.other (cases:assign, cases:read; UNIT-99)
VITE_DEV_TOKEN=dev-token

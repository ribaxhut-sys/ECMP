# Copy to .env (never commit .env). Values below are non-secret local defaults.
# Deployment environment: dev | sit | uat | prod (ADR-010). Outside dev, the app
# refuses to start with default tokens or dev endpoints enabled (ADR-007 gate).
ECMP_ENV=dev
# PostgreSQL via implementation/infrastructure/docker-compose.yml:
ECMP_DATABASE_URL=postgresql+psycopg://ecmp:ecmp_local_only@localhost:5432/ecmp
# Local zero-dependency fallback (SQLite):
# ECMP_DATABASE_URL=sqlite:///./ecmp_dev.db
ECMP_DEV_TOKEN=dev-token
ECMP_DEV_READONLY_TOKEN=dev-readonly-token
ECMP_DEV_NOPERM_TOKEN=dev-noperm-token
ECMP_DEV_SUPERVISOR_TOKEN=dev-supervisor-token
ECMP_DEV_HANDLER_TOKEN=dev-handler-token
ECMP_DEV_FOREIGN_SUPERVISOR_TOKEN=dev-foreign-supervisor-token
ECMP_ENABLE_DEV_ENDPOINTS=false

# ECMP — production reverse proxy (Opsi A: apex landing + module host)
#
# Required env (compose injects):
#   ECMP_DOMAIN       Module hostname, e.g. pengaduan.layanankami.tech
#   ECMP_APEX_DOMAIN  Apex hostname, e.g. layanankami.tech (static landing only)
#   ACME_EMAIL        ACME registration contact (or CADDY_ACME_EMAIL in lab)
#
# Topology:
#   https://$ECMP_APEX_DOMAIN/     → static landing (link to module)
#   https://$ECMP_DOMAIN/          → frontend:3000
#   https://$ECMP_DOMAIN/api/*     → backend:8000
#   https://$ECMP_DOMAIN/health*   → backend:8000
#
# Not Mode B: no SSO, no Identity Adapter, no portal chrome product.

{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

{$ECMP_APEX_DOMAIN}, www.{$ECMP_APEX_DOMAIN} {
	encode gzip zstd

	root * /srv/apex-landing
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$ECMP_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	@backend path /api/* /live /ready /health /version
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# ECMP edge — dual host (Opsi A / DEC-023)
# - Apex ($ECMP_APEX_DOMAIN): static landing → link ke modul
# - Modul ($ECMP_DOMAIN): Next.js + API (Mode A)
# TLS via Let's Encrypt (DNS A untuk kedua host → VPS dulu).

{
	email {$CADDY_ACME_EMAIL}
}

# --- Portal sementara (apex + www) — bukan SSO / bukan modul ---
{$ECMP_APEX_DOMAIN}, www.{$ECMP_APEX_DOMAIN} {
	encode gzip

	root * /srv/apex-landing
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# --- Modul Pengaduan ---
{$ECMP_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health* {
		reverse_proxy backend:8000
	}
	# W-S04: do not expose /docs /redoc /openapi.json on public edge

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

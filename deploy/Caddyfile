# ECMP edge — canonical host layanan.tech (module = apex).
# www + pengaduan → canonical. Bukan Mode B / SSO.
# Domain lama layanankami.tech tidak dilayani di VPS ini.

{
	email {$CADDY_ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

www.{$ECMP_DOMAIN}, pengaduan.{$ECMP_DOMAIN} {
	redir https://{$ECMP_DOMAIN}{uri} permanent
}

{$ECMP_DOMAIN} {
	encode gzip

	handle /api/* {
		request_body {
			max_size 55MB
		}
		reverse_proxy backend:8000
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

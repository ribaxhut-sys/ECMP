ENVIRONMENT=development
ECMP_AUTH_MODE=jwt
ECMP_ENV=shared
ECMP_ENTERPRISE_MODE=false
ECMP_LOCAL_CREDENTIAL_AUTH=false
OIDC_ISSUER=http://localhost:8180/realms/ecmp
OIDC_AUDIENCE=ecmp-api
OIDC_JWKS_URL=http://host.docker.internal:8180/realms/ecmp/protocol/openid-connect/certs
JWT_SECRET_KEY=<REDACTED — use sealed lab JWT_SECRET_KEY>
POSTGRES_PASSWORD=<REDACTED>
DATABASE_URL=postgresql+psycopg://ecmp:<REDACTED>@localhost:5433/ecmp_k4_shared_restore
ALLOWED_ORIGINS=http://localhost:3000
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=logging
DEBUG=false

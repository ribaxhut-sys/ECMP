# ECMP production environment template (TLS / B3)
# Copy to .env and fill secrets. Never commit .env.
#
#   copy .env.production.example .env
#   python scripts/validate-production-config.py --env-file .env --require-production
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Full guide: docs/deployment/TLS_REVERSE_PROXY.md

# --- Public edge ---
ECMP_DOMAIN=ecmp.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_UDP_PORT=443

# --- Runtime ---
ENVIRONMENT=production
APP_VERSION=1.0.0
IMAGE_TAG=v1.0.0
LOG_LEVEL=INFO
DEBUG=false

# --- PostgreSQL ---
POSTGRES_USER=ecmp
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=ecmp

# --- CORS / Trusted hosts / frontend build ---
# Single-host topology (recommended): browser and API share ECMP_DOMAIN.
ALLOWED_ORIGINS=https://ecmp.example.com
ALLOWED_HOSTS=ecmp.example.com,backend
NEXT_PUBLIC_API_BASE_URL=https://ecmp.example.com
PASSWORD_RESET_FRONTEND_BASE_URL=https://ecmp.example.com

# --- JWT ---
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth hardening ---
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_PROVIDER=noop

# --- Reverse proxy trust (production compose default) ---
# Backend publishes no host ports; only Caddy/Nginx on the internal network can connect.
FORWARDED_ALLOW_IPS=*

# ECMP production environment template (TLS / B3)
# Copy to .env and fill secrets. Never commit .env.
#
#   copy .env.production.example .env
#   python scripts/validate-production-config.py --env-file .env --require-production
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Full guide: docs/deployment/TLS_REVERSE_PROXY.md

# --- Public edge ---
ECMP_DOMAIN=ecmp.example.com
# Apex host = static landing only (link to module). Not Mode B SSO.
# Module app stays on ECMP_DOMAIN (e.g. pengaduan.layanankami.tech).
ECMP_APEX_DOMAIN=example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_UDP_PORT=443

# --- Runtime ---
ENVIRONMENT=production
APP_VERSION=1.0.0
IMAGE_TAG=v1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# --- PostgreSQL ---
POSTGRES_USER=ecmp
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=ecmp

# --- Connection pool / query guard (recommended for production) ---
# Defaults (5 / 10 / never recycle / no timeout) are development-sized.
# A process holds up to 2 x (DB_POOL_SIZE + DB_MAX_OVERFLOW) connections
# because sync and async engines pool separately — verify against the
# Postgres max_connections setting before raising.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000

# --- CORS / Trusted hosts / frontend build ---
# Single-host topology (recommended): browser and API share ECMP_DOMAIN.
ALLOWED_ORIGINS=https://ecmp.example.com
ALLOWED_HOSTS=ecmp.example.com,backend
NEXT_PUBLIC_API_BASE_URL=https://ecmp.example.com
PASSWORD_RESET_FRONTEND_BASE_URL=https://ecmp.example.com

# Pengaduan Internal prototype (OQ-INT-001) — default off. Build-time flag:
# ubah lalu rebuild image frontend (docker compose build frontend), restart saja tidak cukup.
NEXT_PUBLIC_ECMP_INTERNAL_COMPLAINTS_UI=false

# --- AuthN mode (SEC-MIG Phase 2 / TASK-PLATFORM-SECMIG-P6-001) ---
# Shared environments must use jwt (startup refuses ECMP_AUTH_MODE=dev when
# ECMP_ENV=shared OR ENVIRONMENT is staging/production).
ECMP_AUTH_MODE=jwt
ECMP_ENV=shared
# ADR-014 / audit K-3 — disable Mode A credential AuthN in production.
ECMP_LOCAL_CREDENTIAL_AUTH=false
# Mode B runtime — keep false until Architecture Board unlocks Mode B (C-7).
ECMP_ENTERPRISE_MODE=false
OIDC_ISSUER=https://idp.example.com/realms/ecmp
OIDC_AUDIENCE=ecmp-api
OIDC_JWKS_URL=https://idp.example.com/realms/ecmp/protocol/openid-connect/certs
OIDC_JWKS_CACHE_TTL_SECONDS=600

# --- Org-scope service bypass (SEC-MIG Phase 4) ---
# Require BOTH: subject UUID list + role allowlist. Empty either → default deny
# when principal has no orgUnitId claim. Do not put human subjects here.
ECMP_ORG_SCOPE_SERVICE_SUBJECTS=
ECMP_ORG_SCOPE_SERVICE_ALLOWLIST=

# --- JWT (dev-mode issuance secrets; retained for dual-mode tooling) ---
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth hardening ---
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_PROVIDER=noop

# --- CM Batch 1 Master Customer (TASK-OPS-03 / EX-A) ---
# stub = synthetic customers only. Do not set enterprise for real-customer production
# until an approved Enterprise HTTP CustomerProvider adapter is delivered.
CUSTOMER_PROVIDER=stub
# CUSTOMER_PROVIDER_ENTERPRISE_BASE_URL=

# --- Reverse proxy trust (production compose default) ---
# Backend publishes no host ports; only Caddy/Nginx on the internal network can connect.
FORWARDED_ALLOW_IPS=*

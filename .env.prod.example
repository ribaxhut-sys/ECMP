# Copy to .env.prod (git-ignored) before production cutover:
#   cp .env.prod.example .env.prod
#   # fill secrets + real IdP OIDC_* from bilateral platform contract
#   python scripts/validate-production-config.py --env-file .env.prod --require-production
#   docker compose -f docker-compose.prod.yml --env-file .env.prod config
#
# HARD RULE (SoT): Do NOT invent OIDC_ISSUER / realm as if platform-approved.
# See deploy/evidence/Mode_B_Blocked_Pending_IdP_Contract_20260801.md
# and W-S03 (lab-only — blocked for promote).
#
# Prerequisite DNS: ECMP_DOMAIN → VPS public IPv4

# --- Public edge (docker-compose.prod.yml) ---
ENVIRONMENT=production
APP_VERSION=1.2.0-rc.1
IMAGE_TAG=1.2.0-rc.1
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

ECMP_DOMAIN=pengaduan.layanankami.tech
# Compose accepts ACME_EMAIL or legacy CADDY_ACME_EMAIL
ACME_EMAIL=ops@layanankami.tech
CADDY_ACME_EMAIL=ops@layanankami.tech
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_UDP_PORT=443

POSTGRES_USER=ecmp
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ecmp

ALLOWED_ORIGINS=https://pengaduan.layanankami.tech
ALLOWED_HOSTS=pengaduan.layanankami.tech,backend
NEXT_PUBLIC_API_BASE_URL=https://pengaduan.layanankami.tech
PASSWORD_RESET_FRONTEND_BASE_URL=https://pengaduan.layanankami.tech

# --- AuthN (REL-SEC-001 / SEC-MIG) — REQUIRED for ENVIRONMENT=production ---
ECMP_AUTH_MODE=jwt
ECMP_ENV=shared
ECMP_LOCAL_CREDENTIAL_AUTH=false
ECMP_ENTERPRISE_MODE=false
# REPLACE with bilateral IdP contract values — placeholders fail AuthN smoke / are not GO:
OIDC_ISSUER=https://idp.example.com/realms/REPLACE_WITH_PLATFORM_CONTRACT
OIDC_AUDIENCE=ecmp-api
OIDC_JWKS_URL=https://idp.example.com/realms/REPLACE_WITH_PLATFORM_CONTRACT/protocol/openid-connect/certs
OIDC_JWKS_CACHE_TTL_SECONDS=600

ECMP_ORG_SCOPE_SERVICE_SUBJECTS=
ECMP_ORG_SCOPE_SERVICE_ALLOWLIST=

JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_PROVIDER=noop

FORWARDED_ALLOW_IPS=*
CUSTOMER_PROVIDER=local                  # lab: Postgres customers cache (ID/name/phone); stub=synthetic; enterprise=skeleton

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000

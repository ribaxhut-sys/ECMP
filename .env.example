# ECMP foundation — copy to .env and adjust for local use
# cp .env.example .env
#
# Classification legend (R6-03):
#   [Required]         Must be set for the named environment to start
#   [Optional]         Has a safe default; override when needed
#   [Development Only] Forbidden or meaningless outside development/test
#   [Production Only]  Required/stricter in production (also enforced for staging unless noted)
#   [Deprecated]       Do not use
#
# Local DEVELOPMENT values below are intentionally convenient and weak.
# Staging/production MUST override secrets and origins — startup fail-fast rejects
# weak JWT/DB passwords, localhost origins, DEBUG=true, and EMAIL_PROVIDER=logging.
#
# Validate before deploy:
#   python scripts/validate-production-config.py --env-file .env

# --- Runtime ---
ENVIRONMENT=development                 # [Required] development | test | staging | production
APP_VERSION=1.0.0                       # [Optional] release label (compose/build may override)
LOG_LEVEL=INFO                          # [Optional] DEBUG|INFO|WARNING|ERROR
DEBUG=false                             # [Development Only] must be false outside development/test

# --- PostgreSQL (Required) ---
POSTGRES_USER=ecmp                      # [Required]
POSTGRES_PASSWORD=ecmp                  # [Required] weak OK in development only
POSTGRES_DB=ecmp                        # [Required]
POSTGRES_HOST=localhost                 # [Required] compose backend overrides to "postgres"
POSTGRES_PORT=5433                      # [Optional] host mapping; container listens on 5432
# DATABASE_URL=                         # [Optional] full URL override (CI uses this)

# --- API / CORS ---
BACKEND_PORT=8000                       # [Optional] host port mapping (local compose only)
ALLOWED_ORIGINS=http://localhost:3000   # [Required] comma-separated; no * outside development
ALLOWED_HOSTS=localhost,127.0.0.1,backend  # [Required outside development] TrustedHost list
# FORWARDED_ALLOW_IPS=127.0.0.1         # [Optional] uvicorn trusted proxies; prod compose uses *

# --- Production TLS edge (docker-compose.prod.yml) — see .env.production.example ---
# ECMP_DOMAIN=ecmp.example.com          # [Production Only] public hostname
# ACME_EMAIL=ops@example.com            # [Production Only] Caddy ACME contact

# --- AuthN mode (SEC-MIG Phase 2 / TASK-PLATFORM-SECMIG-P2-001) ---
ECMP_AUTH_MODE=dev                      # [Required] dev (default lab HS256) | jwt (IdP RS256)
ECMP_ENV=local                          # [Required] local|ci|shared — shared forbids ECMP_AUTH_MODE=dev
# OIDC_* required only when ECMP_AUTH_MODE=jwt (Phase 1 Keycloak defaults below)
# OIDC_ISSUER=http://localhost:8180/realms/ecmp
# OIDC_AUDIENCE=ecmp-api
# OIDC_JWKS_URL=http://localhost:8180/realms/ecmp/protocol/openid-connect/certs
# OIDC_JWKS_CACHE_TTL_SECONDS=600

# --- Org-scope service bypass (SEC-MIG Phase 4 / TASK-PLATFORM-SECMIG-P4) ---
# Active only when ECMP_AUTH_MODE=jwt. Both lists required for machine bypass;
# empty either list = default deny when orgUnitId claim is missing.
# ECMP_ORG_SCOPE_SERVICE_SUBJECTS=        # [Optional] comma-separated service subject UUIDs
# ECMP_ORG_SCOPE_SERVICE_ALLOWLIST=      # [Optional] comma-separated allowlisted role codes

# --- JWT / session (Required) ---
JWT_SECRET_KEY=change-me-in-production  # [Required] >=32 chars outside development
JWT_ALGORITHM=HS256                     # [Required] HS256 only (dev-mode issuance)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15      # [Optional]
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7         # [Optional]

# --- Login brute-force (Optional; in-memory — Redis not used) ---
LOGIN_RATE_LIMIT_ENABLED=true           # [Optional]
LOGIN_MAX_FAILED_ATTEMPTS=5             # [Optional]
LOGIN_LOCKOUT_SECONDS=300               # [Optional]
# REDIS_URL=                            # [Deprecated] not used by foundation stack

# --- Frontend (Required for compose / production builds) ---
FRONTEND_PORT=3000                      # [Optional] host port mapping
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000  # [Required] build-arg; no silent default

# --- Password management / email (Identity) ---
PASSWORD_MIN_LENGTH=8                   # [Optional] 8..72
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15  # [Optional]
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:3000  # [Required] must match an ALLOWED_ORIGINS entry outside development
EMAIL_PROVIDER=logging                  # [Development Only]=logging; staging/production use noop until SMTP

# --- CM Batch 1 Master Customer (ADR-002 read-only; TASK-OPS-03 stance) ---
CUSTOMER_PROVIDER=stub                  # [Required stance] stub=synthetic seed; enterprise=skeleton UNAVAILABLE
# CUSTOMER_PROVIDER_ENTERPRISE_BASE_URL= # [Optional] only after approved Enterprise HTTP adapter

# --- pgAdmin (compose profile: tools) ---
PGADMIN_PORT=5050                       # [Optional]
PGADMIN_DEFAULT_EMAIL=admin@example.com # [Optional]
PGADMIN_DEFAULT_PASSWORD=admin          # [Optional] weak OK in development only

# --- Image tagging (Optional) ---
# IMAGE_TAG=v1.0.0                      # [Optional] compose image tag (default: latest)

# ECMP foundation — copy to .env and adjust for local use
# cp .env.example .env
#
# Local DEVELOPMENT values below are intentionally convenient and weak.
# Staging/production MUST override POSTGRES_PASSWORD, JWT_SECRET_KEY,
# PGADMIN_DEFAULT_PASSWORD, and NEXT_PUBLIC_API_BASE_URL with strong secrets /
# real origins (runtime + compose fail-fast when missing or weak outside development).

ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL
POSTGRES_USER=ecmp
POSTGRES_PASSWORD=ecmp
POSTGRES_DB=ecmp
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Host mapping defaults to 5433 (container still listens on 5432).

# Optional full URL override (backend)
# DATABASE_URL=postgresql+psycopg://ecmp:ecmp@localhost:5432/ecmp

# API
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# JWT / session (REQUIRED: replace before staging/production — secret guard rejects defaults)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Login brute-force protection (R2-03)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Frontend (required for compose / production builds — no silent code default)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# pgAdmin (compose profile: tools)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

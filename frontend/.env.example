# ECMP Frontend — local environment

# Backend API origin (auth + domain APIs). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# UI batch gate (WF-001-R1 + WF-001-R2).
# B0 = shell + mock auth + placeholders
# B1 = Supervisor Assign loop (SCR-Q-02 unassigned + SCR-WS-09)
# B2 = Officer Queue + Handle (SCR-Q-01 + SCR-WS-04)
# B3 = Intake (SCR-WS-01 New Intake + SCR-WS-02 Follow-up)
# B4 = Submit (SCR-WS-05 Submit for Review)
# B5 = Approval close (SCR-Q-02 pending + SCR-WS-10)
# B6 = Queue Supervisor full priority (SCR-Q-02 escalation + SLA + unassigned)
# R2B1 = Reject Continuity (SCR-WS-06 + SCR-HX-01 embedded)
# R2B2 = Reopen Chain (SCR-WS-03 → SCR-WS-12 → SCR-WS-07)
NEXT_PUBLIC_ECMP_UI_BATCH=R2B3

# Optional: enable mock auth without setting UI batch (persona login without API).
# NEXT_PUBLIC_ECMP_MOCK_AUTH=true

# Optional lab prototype: Pengaduan Internal (Cabang ↔ Pusat) UI + /internal routes.
# Default off — no FRD/BR/ADR/OpenAPI yet. Do not enable in shared/prod without Board.
NEXT_PUBLIC_ECMP_INTERNAL_COMPLAINTS_UI=true

# Dashboard environment chip: lab | production (baked at Next.js build).
# Lab compose defaults to lab so the bar shows LAB instead of Production.
NEXT_PUBLIC_ECMP_SURFACE=lab
